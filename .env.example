NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://reachinbox:password@localhost:5432/reachinbox_db?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
SESSION_SECRET=my_super_secret_session_key
ENCRYPTION_KEY=my_super_secret_32_byte_encryption_key_12345!

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Slack OAuth
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_CALLBACK_URL=http://localhost:4000/auth/slack/callback

# BullMQ & Workers
WORKER_CONCURRENCY=8
DEFAULT_EMAIL_DELAY_MS=2000
DEFAULT_MAX_EMAILS_PER_HOUR=100
MAX_RETRIES=3
MAX_LEADS_PER_REQUEST=10000

# Bull Board
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=admin

# Seed Senders
SENDER_1_NAME=Demo Sender 1
SENDER_1_EMAIL=demo1@example.com
SENDER_1_SMTP_HOST=smtp.ethereal.email
SENDER_1_SMTP_PORT=587
SENDER_1_SMTP_USERNAME=ethereal_user_1
SENDER_1_SMTP_PASSWORD=ethereal_password_1
